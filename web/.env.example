# Copy to .env for local development. Only put public values here:
# anything starting with VITE_ is bundled into the browser build.

# Base path of the API. Default is /api (proxied to the deployed backend by vite.config.js in dev).
# VITE_API_URL=/api

# Set to true to run fully offline on web/public/mock/cells.geojson.
# Production builds never use the mock unless this is set explicitly.
# VITE_USE_MOCK=true
